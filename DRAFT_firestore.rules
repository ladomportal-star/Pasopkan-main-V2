rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'firstName']) 
        && data.keys().size() <= 8
        && data.firstName is string && data.firstName.size() <= 100
        && (data.lastName == null || (data.lastName is string && data.lastName.size() <= 100))
        && data.email is string && data.email.size() <= 200
        && (data.phone == null || (data.phone is string && data.phone.size() <= 30))
        && (data.gender == null || (data.gender is string && data.gender.size() <= 20))
        && (data.dob == null || (data.dob is string && data.dob.size() <= 20))
        && (data.profilePic == null || (data.profilePic is string && data.profilePic.size() <= 500000));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['eventId', 'userId', 'rating', 'comment'])
        && data.keys().size() <= 7
        && data.eventId is string && data.eventId.size() <= 100
        && data.userId is string && data.userId == request.auth.uid
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 5000
        && (data.userName == null || (data.userName is string && data.userName.size() <= 200))
        && (data.date == null || (data.date is string && data.date.size() <= 20));
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['eventId', 'userId', 'tierId', 'quantity'])
        && data.keys().size() <= 11
        && data.eventId is string && data.eventId.size() <= 100
        && data.userId is string && data.userId == request.auth.uid
        && data.tierId is string && data.tierId.size() <= 100
        && data.quantity is int && data.quantity >= 1 && data.quantity <= 50
        && (data.eventTitle == null || (data.eventTitle is string && data.eventTitle.size() <= 300))
        && (data.tierName == null || (data.tierName is string && data.tierName.size() <= 100))
        && (data.price == null || (data.price is number))
        && (data.selectedDate == null || (data.selectedDate is string && data.selectedDate.size() <= 20))
        && (data.selectedTime == null || (data.selectedTime is string && data.selectedTime.size() <= 20))
        && (data.status == null || (data.status is string && data.status.size() <= 50));
    }

    // Rules for collections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['firstName', 'lastName', 'phone', 'gender', 'dob', 'profilePic'])
      );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidReview(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['comment', 'rating', 'userName', 'date'])
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /tickets/{ticketId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(ticketId) && isValidTicket(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidTicket(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if false;
    }
  }
}
