# ────────────────────────────────────────────────────────────────
#  Pasopkan Backend — environment variables
#  Copy to `.env` and fill in.  All values below are optional; the
#  server degrades gracefully (in-memory stores) when they are absent.
# ────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins for CORS.
# Leave empty to reflect any origin (fine for local dev).
CORS_ORIGIN=

# ── Database: Supabase / PostgreSQL (optional) ─────────────────
# If left blank the ticket/review APIs run in resilient in-memory mode.
#
# PREFERRED — one connection string. Supabase dashboard →
#   Project Settings → Database → Connection string → "URI".
#   * App server  : use the "Session pooler"  string  (…pooler.supabase.com:5432)
#   * Migrations  : use the "Direct connection" string (db.<ref>.supabase.co:5432)
#   Keep the "?sslmode=require" suffix — SSL is auto-enabled for non-local hosts.
DATABASE_URL=
DATABASE_POOL_MAX=10

# FALLBACK — discrete vars, used only when DATABASE_URL is empty.
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DB_NAME=pasopkan_db
SQL_USER=postgres
SQL_PASSWORD=
# Force SSL for the discrete vars (Supabase needs this; local usually not).
DATABASE_SSL=false

# ── Firebase Admin (ID-token verification) ──────────────────────
FIREBASE_PROJECT_ID=turnkey-envelope-jtn3v
# ID tokens (JWTs) are verified from FIREBASE_PROJECT_ID alone (Google's
# public keys). A service-account key is only needed for extras such as
# revocation checks.
GOOGLE_APPLICATION_CREDENTIALS=

# DANGER: skips Firebase ID-token (JWT) verification and trusts the bearer
# string as the uid. Local development and tests ONLY. The server refuses
# to start with this enabled when NODE_ENV=production.
AUTH_DEV_BYPASS=false

# ── Serving the built frontend from this server (optional) ──────
# Path to Frontend/dist. When set (and NODE_ENV=production) the API
# also serves the SPA, so you can deploy a single process.
FRONTEND_DIST=

# ── Observability & limits (optional) ──────────────────────────
# pino level: trace|debug|info|warn|error|fatal|silent  (default: debug in dev, info in prod)
LOG_LEVEL=
# express-rate-limit on /api/*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
