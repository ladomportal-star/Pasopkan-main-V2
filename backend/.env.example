# ────────────────────────────────────────────────────────────────
#  Pasopkan backend — environment variables
#  Copy to `.env` and fill in. DATABASE_URL (or SQL_*) and SUPABASE_URL are
#  required: there are no in-memory fallbacks and no mock logins.
# ────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins for CORS.
# Leave empty to reflect any origin (fine for local dev).
CORS_ORIGIN=

# ── Database: Supabase / PostgreSQL (required) ─────────────────
#
# PREFERRED — one connection string. Supabase dashboard →
#   Project Settings → Database → Connection string → "URI".
#   * App server  : use the "Session pooler"  string  (…pooler.supabase.com:5432)
#   * Migrations  : use the "Direct connection" string (db.<ref>.supabase.co:5432)
#   Keep the "?sslmode=require" suffix — SSL is auto-enabled for non-local hosts.
DATABASE_URL=
DATABASE_POOL_MAX=10

# FALLBACK — discrete vars, used only when DATABASE_URL is empty.
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DB_NAME=pasopkan_db
SQL_USER=postgres
SQL_PASSWORD=
# Force SSL for the discrete vars (Supabase needs this; local usually not).
DATABASE_SSL=false

# ── Auth: Supabase Auth (the project the frontend signs in with) ─
# Access tokens (JWTs) are verified against the project's public JWKS at
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# so no secret is needed. Without it, every authenticated route returns 503.
SUPABASE_URL=https://<project-ref>.supabase.co

# ── OTP (api.otp.dev) ───────────────────────────────────────────
OTP_API_KEY=
OTP_SENDER_ID=
OTP_TEMPLATE_ID=

# ── Serving the built frontend from this server (optional) ──────
# Path to frontend/dist. When set (and NODE_ENV=production) the API
# also serves the SPA, so you can deploy a single process.
FRONTEND_DIST=

# ── Observability & limits (optional) ──────────────────────────
# pino level: trace|debug|info|warn|error|fatal|silent  (default: debug in dev, info in prod)
LOG_LEVEL=
# express-rate-limit on /api/*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
