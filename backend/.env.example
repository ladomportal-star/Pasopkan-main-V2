# ────────────────────────────────────────────────────────────────
#  Pasopkan backend — environment variables
#  Copy to `.env` and fill in. DATABASE_URL (or SQL_*) and SUPABASE_URL are
#  required: there are no in-memory fallbacks and no mock logins.
# ────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins for CORS.
# Leave empty to reflect any origin in development only. REQUIRED in
# production (NODE_ENV=production) - if unset there, all cross-origin
# browser requests are blocked (server still boots; see checkEnv warning).
CORS_ORIGIN=

# ── Database: Supabase / PostgreSQL (required) ─────────────────
#
# PREFERRED — one connection string. Supabase dashboard →
#   Project Settings → Database → Connection string → "URI".
#   * App server  : use the "Session pooler"  string  (…pooler.supabase.com:5432)
#   * Migrations  : use the "Direct connection" string (db.<ref>.supabase.co:5432)
#   Configure TLS for your provider; do not disable certificate verification.
DATABASE_URL=
# Prisma CLI migration connection, targeting the same NEW empty database.
DIRECT_DATABASE_URL=
DATABASE_POOL_MAX=10

# FALLBACK — discrete vars, used only when DATABASE_URL is empty.
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DB_NAME=
SQL_USER=postgres
SQL_PASSWORD=
# Force SSL for the discrete vars (Supabase needs this; local usually not).
DATABASE_SSL=false

# ── Auth: Supabase Auth (the project the frontend signs in with) ─
# Access tokens (JWTs) are verified against the project's public JWKS at
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# so no secret is needed. Without it, every authenticated route returns 503.
SUPABASE_URL=https://<project-ref>.supabase.co

# Public Auth key used server-side to request and verify phone OTPs. Prefer the
# current sb_publishable_* key; the legacy anon key is also accepted by Supabase.
SUPABASE_PUBLISHABLE_KEY=

# SECRET — full admin access, bypasses Row Level Security. Never expose to
# the frontend or commit it. Supabase dashboard -> Project Settings -> API ->
# "service_role" key. Used by backend media upload and private URL signing.
# Without it, media storage endpoints return 503.
SUPABASE_SERVICE_ROLE_KEY=

# Phone OTP is sent by Supabase Auth. Configure Authentication > Providers >
# Phone and either an SMS provider or a Send SMS Hook for your regional API.

# ── Supabase Send SMS Hook -> Wenova (server-only) ───────────────
# In Supabase Authentication > Hooks > Send SMS select HTTP and set the URL to
# https://api.pasopkan.la/api/auth-hooks/send-sms (adjust if API host differs).
# Copy that hook's signing secret here; format: v1,whsec_<base64>.
# Keep this and the Wenova credential in Railway/server secrets, never VITE_*.
SUPABASE_SEND_SMS_HOOK_SECRET=
# Use API Token OR Script ID from Wenova Dashboard > Key (Token preferred).
WENOVA_SMS_TOKEN=
WENOVA_SMS_SCRIPT_ID=
# Use only a sender/header approved by Wenova for this account.
WENOVA_SMS_HEADER=
WENOVA_SMS_API_URL=https://apimicroservices.wenova.fun/sms/package

# ── Payments (disabled until a provider adapter is implemented) ─
# Do not set these until the provider API and webhook documentation are available.
# Credentials stay on the backend only; never use VITE_ prefixed variables.
PAYMENT_PROVIDER=
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_MERCHANT_ID=
PAYMENT_WEBHOOK_SECRET=

# ── Serving the built frontend from this server (optional) ──────
# Path to frontend/dist. When set (and NODE_ENV=production) the API
# also serves the SPA, so you can deploy a single process.
FRONTEND_DIST=

# ── Observability & limits (optional) ──────────────────────────
# pino level: trace|debug|info|warn|error|fatal|silent  (default: debug in dev, info in prod)
LOG_LEVEL=
# express-rate-limit on /api/*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
